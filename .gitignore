**.DS_Store
**/node_modules/
/vendor/

# Built front-end assets — generated by `npm run build` and the release workflow.
# assets/js/ is entirely webpack output (JS sources live in src/); assets/css/
# keeps the hand-written *.css sources, so only the generated *.min.css is ignored there.
/assets/js/
/assets/css/*.min.css

# Translation template — generated by `wp i18n make-pot` in the release workflow.
# It harvests strings from the built assets/js/ bundles, so a hand-generated copy
# only ever reflects whatever build happened to be on disk at the time.
/languages/*.pot
