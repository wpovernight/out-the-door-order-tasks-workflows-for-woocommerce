{
	"compilerOptions": {
		"baseUrl": "./src",
		"paths": {
			// Consumers outside src/sdk must import the flat '@sdk' specifier:
			// that is the only shape webpack's external can resolve, so type
			// checking it against the barrel is what keeps the two in step.
			"@sdk": ["sdk/index.ts"],
			// Deep paths stay mapped for SDK-internal imports, which are bundled
			// normally rather than externalised.
			"@sdk/*": ["sdk/*"],
			"@orderManager/*": ["order-manager/*"],
			"@taskManager/*": ["task-manager/*"],
			"@orderEdit/*": ["order-edit/*"]
		},
		"target": "ES6",
		"jsx": "react",
		"module": "ESNext",
		"moduleResolution": "node",
		"strict": true,
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true,
		"outDir": "./dist",
		"types": ["react", "node"]
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "build", "dist"]
}
